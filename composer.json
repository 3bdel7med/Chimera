{
    "name": "abdelhmed/chimera",
    "description": "Describe a feature in plain language; Chimera plans it with Gemini, generates the files in batches, injects them into your Laravel app with AST, and verifies them with tests.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "gemini", "code-generation", "scaffolding", "ast"],
    "authors": [
        { "name": "Abdelhamed Fathy" }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "laravel/prompts": "^0.1.15|^0.2|^0.3",
        "nikic/php-parser": "^5.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Abdelhmed\\Chimera\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Abdelhmed\\Chimera\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abdelhmed\\Chimera\\ChimeraServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
